---
layout: layouts/base.njk
permalink: whats-new/index.html
bodyClass: whats-new-page
pageTitle: What’s new in Dekopon
pageDescription: An operator console over the live broker, a much bigger sandboxed shell, and providers that now ship from their own repositories.
ogType: article
---
<section class="release-hero">
  <div class="release-hero-mesh" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="shell release-hero-grid">
    <div class="release-hero-copy">
      <p class="release-eyebrow reveal"><span aria-hidden="true"></span>{{ whatsNew.hero.eyebrow }} · {{ release.date }}</p>
      <h1 class="reveal reveal-delay-1"><span>{{ release.tag }}</span>{{ whatsNew.hero.title }}</h1>
      <p class="release-lede reveal reveal-delay-2">{{ whatsNew.hero.lede }}</p>
      <div class="release-actions reveal reveal-delay-3">
        <a class="button button-primary" href="#get-latest">Get {{ release.tag }} <span aria-hidden="true">↓</span></a>
        <a class="button button-secondary" href="{{ release.url }}">GitHub release <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <aside class="release-card reveal reveal-delay-2" aria-label="{{ release.tag }} release details">
      <div class="release-card-top">
        <span><i aria-hidden="true"></i> Current release</span>
        <code>{{ release.shortRevision }}</code>
      </div>
      <strong>{{ release.tag }}</strong>
      <p>Released <time datetime="{{ release.dateIso }}">{{ release.date }}</time></p>
      <div class="release-command" data-copy-group>
        <span aria-hidden="true">$</span>
        <code>{{ release.installCommand }}</code>
        <button type="button" data-copy="{{ release.installCommand }}" aria-label="Copy install command">
          <span class="copy-label">Copy</span>
        </button>
      </div>
      <a href="{{ release.sourceUrl }}">See the code for this release <span aria-hidden="true">→</span></a>
    </aside>
  </div>

  <div class="shell release-metrics reveal reveal-delay-4">
    {% for metric in whatsNew.metrics %}
      <div><strong>{{ metric.value }}</strong><span>{{ metric.label }}</span></div>
    {% endfor %}
  </div>
</section>

<section class="release-summary section" aria-labelledby="release-summary-title">
  <div class="shell">
    <div class="release-section-heading">
      <div>
        <span class="section-kicker purple">The short version</span>
        <h2 id="release-summary-title">The release in three points.</h2>
      </div>
      <p>{{ whatsNew.summary }}</p>
    </div>

    <div class="release-highlight-grid">
      {% for highlight in whatsNew.highlights %}
        <article class="release-highlight reveal{% if loop.index > 1 %} reveal-delay-{{ loop.index - 1 }}{% endif %}">
          <div class="release-highlight-top"><span>{{ highlight.number }}</span><small>{{ highlight.kicker }}</small></div>
          <h3>{{ highlight.title }}</h3>
          <p>{{ highlight.body }}</p>
          <ul>
            {% for point in highlight.points %}<li>{{ point }}</li>{% endfor %}
          </ul>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="release-path-section" aria-labelledby="release-path-title">
  <div class="shell">
    <div class="release-path-heading">
      <div><span class="section-kicker mint">{{ whatsNew.path.kicker }}</span><h2 id="release-path-title">{{ whatsNew.path.title }}</h2></div>
      <p>{{ whatsNew.path.body }}</p>
    </div>
    <ol class="release-path" aria-label="{{ whatsNew.path.ariaLabel }}">
      {% for step in whatsNew.path.steps %}
        <li><span>0{{ loop.index }}</span><strong>{{ step.name }}</strong><small>{{ step.detail }}</small></li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="release-details section" aria-labelledby="release-details-title">
  <div class="shell">
    <div class="release-section-heading release-details-heading">
      <div>
        <span class="section-kicker orange">Under the hood</span>
        <h2 id="release-details-title">{{ whatsNew.changes | length }} changes in {{ release.tag }}.</h2>
      </div>
      <p>{{ whatsNew.detailsIntro }}</p>
    </div>

    <div class="release-change-list">
      {% for change in whatsNew.changes %}
        <article class="release-change reveal">
          <div class="release-change-index"><span>0{{ loop.index }}</span><i aria-hidden="true"></i></div>
          <div>
            <small>{{ change.tag }}</small>
            <h3>{{ change.title }}</h3>
            <p>{{ change.body }}</p>
            <a class="text-link" href="{% if change.link.release %}{{ release.url }}{% else %}{{ change.link.href }}{% endif %}">{{ change.link.label }} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      {% endfor %}
    </div>

    <aside class="release-telemetry reveal" aria-label="{{ release.tag }} authority change">
      <div><span>Authority boundary</span><strong>{{ whatsNew.telemetry.value }}</strong><small>{{ whatsNew.telemetry.title }}</small></div>
      <div><p>{{ whatsNew.telemetry.body }}</p><small>{{ whatsNew.telemetry.note }}</small></div>
    </aside>
  </div>
</section>

<section class="release-install section" id="get-latest" aria-labelledby="release-install-title">
  <div class="shell">
    <div class="release-section-heading release-install-heading">
      <div>
        <span class="section-kicker mint">Available now</span>
        <h2 id="release-install-title">Install it from Homebrew, crates.io, or the image.</h2>
      </div>
      <p>{{ whatsNew.installIntro }}</p>
    </div>

    <div class="release-package-grid">
      {% for package in whatsNew.packages %}
        {% if package.name == "Homebrew" %}
          {% set packageCommand = "brew install dekopon-agents/tap/dekopon" %}
        {% elif package.name == "crates.io" %}
          {% set packageCommand = "cargo install --locked --version " ~ release.version ~ " dekopon-run" %}
        {% else %}
          {% set packageCommand = release.installCommand %}
        {% endif %}
        <article class="release-package reveal{% if loop.index > 1 %} reveal-delay-{{ loop.index - 1 }}{% endif %}">
          <div><code>{{ package.name }}</code><span>{{ package.role }}</span></div>
          <p>{{ package.body }}</p>
          <div class="release-package-command" data-copy-group>
            <code>{{ packageCommand }}</code>
            <button type="button" data-copy="{{ packageCommand }}" aria-label="Copy {{ package.name }} install command"><span class="copy-label">Copy</span></button>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="release-scope section" aria-labelledby="release-scope-title">
  <div class="shell">
    <div class="release-section-heading">
      <div>
        <span class="section-kicker purple">Where {{ release.tag }} stands</span>
        <h2 id="release-scope-title">Deployable, and still pre-production.</h2>
      </div>
      <p>{{ whatsNew.scopeIntro }}</p>
    </div>

    <div class="release-scope-grid">
      <article class="release-scope-card current reveal">
        <span><i aria-hidden="true"></i> Current in {{ release.tag }}</span>
        <ul>{% for item in whatsNew.scope.current %}<li>{{ item }}</li>{% endfor %}</ul>
      </article>
      <article class="release-scope-card next reveal reveal-delay-1">
        <span><i aria-hidden="true"></i> Coming next</span>
        <ul>{% for item in whatsNew.scope.next %}<li>{{ item }}</li>{% endfor %}</ul>
      </article>
    </div>

    <article class="previous-release reveal">
      <div><span>Previous release</span><strong>{{ whatsNew.previous.version }}</strong></div>
      <div><h3>{{ whatsNew.previous.title }}</h3><p>{{ whatsNew.previous.body }}</p></div>
      <a href="{{ whatsNew.previous.url }}" aria-label="View the {{ whatsNew.previous.version }} release">{{ whatsNew.previous.label }} <span aria-hidden="true">↗</span></a>
    </article>
  </div>
</section>

<section class="release-closing">
  <div class="shell release-closing-inner">
    <div><span class="section-kicker mint">{{ release.tag }} is available now</span><h2>{{ whatsNew.closing.title }}</h2></div>
    <div><p>{{ whatsNew.closing.body }}</p><div class="release-actions"><a class="button button-white" href="/deploy/">Deploy {{ release.tag }} <span aria-hidden="true">→</span></a><a class="button button-ghost" href="/almanac/">See how it works <span aria-hidden="true">→</span></a></div></div>
  </div>
</section>
