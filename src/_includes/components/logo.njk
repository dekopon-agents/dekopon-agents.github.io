{% macro logo(extraClass = "") %}
<img
  class="brand-mark {{ extraClass }}"
  src="/assets/dekopon-surf-logo-64.webp"
  srcset="/assets/dekopon-surf-logo-64.webp 1x, /assets/dekopon-surf-logo-128.webp 2x"
  width="40"
  height="40"
  alt=""
  aria-hidden="true"
  decoding="async">
{% endmacro %}

{% macro largeLogo() %}
<img
  class="closing-mark"
  src="/assets/dekopon-surf-logo-256.webp"
  srcset="/assets/dekopon-surf-logo-256.webp 1x, /assets/dekopon-surf-logo-512.webp 2x"
  width="136"
  height="136"
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async">
{% endmacro %}
