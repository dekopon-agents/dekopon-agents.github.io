{% from "components/logo.njk" import logo %}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle or site.title }}</title>
  <meta name="description" content="{{ pageDescription or site.description }}">
  <meta name="theme-color" content="{{ site.themeColor }}">
  <link rel="canonical" href="{{ canonical or (site.url ~ page.url) }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ canonical or (site.url ~ page.url) }}">
  <meta property="og:title" content="{{ pageTitle or site.title }}">
  <meta property="og:description" content="{{ pageDescription or site.description }}">
  <meta property="og:image" content="{{ site.url }}/assets/social-card.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Dekopon surfing mascot: secure rails for AI agents on your hardware">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle or site.title }}">
  <meta name="twitter:description" content="{{ pageDescription or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/social-card.png">

  <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" sizes="180x180">
  <link rel="stylesheet" href="/assets/styles.css">
  {% if almanacPage %}<link rel="stylesheet" href="/assets/almanac.css">{% endif %}
  <link rel="stylesheet" href="/assets/release.css">
  <script>document.documentElement.classList.remove('no-js');</script>
  <script src="/assets/site.js" defer></script>
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="/" aria-label="Dekopon home">
        {{ logo() }}
        <span>{{ site.wordmark }}</span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        {% for item in site.nav %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
      </nav>

      <div class="header-actions">
        <a class="version-link" href="{{ site.releaseNotes }}" aria-label="What’s new in Dekopon {{ site.version }}">
          <span class="live-dot" aria-hidden="true"></span>
          {{ site.version }}
        </a>
        <a class="header-github" href="{{ site.repository }}" aria-label="Dekopon on GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.5v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.4-1.3-5.4-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.4 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5A11.5 11.5 0 0 0 12 .7Z"/></svg>
          <span>GitHub</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
          <span class="sr-only">Open navigation</span>
          <span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" data-mobile-nav hidden>
      {% for item in site.nav %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
      <a href="{{ site.repository }}">View on GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="shell footer-main">
      <a class="brand footer-brand" href="/" aria-label="Dekopon home">
        {{ logo() }}
        <span>{{ site.wordmark }}</span>
      </a>
      <div class="footer-links">
        {% for group in site.footer %}
          <div>
            <h2>{{ group.heading }}</h2>
            {% for link in group.links %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="shell footer-bottom">
      <p>{{ site.copyright }}</p>
      <p>{{ site.footerNote }}</p>
    </div>
  </footer>
</body>
</html>
