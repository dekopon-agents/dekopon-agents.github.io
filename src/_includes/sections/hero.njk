<section class="hero" id="top">
  <div class="hero-mesh" aria-hidden="true">
    <div class="mesh-blob mesh-blob-a"></div>
    <div class="mesh-blob mesh-blob-b"></div>
    <div class="mesh-blob mesh-blob-c"></div>
    <div class="mesh-blob mesh-blob-d"></div>
    <svg class="mesh-lines" viewBox="0 0 1600 900" preserveAspectRatio="none">
      <path d="M-120 756C205 473 427 678 708 450S1184 82 1708 217"/>
      <path d="M-81 853C222 586 472 777 765 539s500-352 902-272"/>
      <path d="M111-73c82 195 242 240 425 208s317-7 384 172"/>
    </svg>
  </div>

  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="eyebrow reveal">
        <span class="eyebrow-spark" aria-hidden="true"></span>
        {{ home.hero.eyebrow }}
      </div>
      <h1 class="reveal reveal-delay-1">{{ home.hero.title }}<br><span class="gradient-text">{{ home.hero.titleAccent }}</span></h1>
      <p class="hero-lede reveal reveal-delay-2">{{ home.hero.lede }}</p>
      <div class="hero-buttons reveal reveal-delay-3">
        <a class="button button-primary" href="{{ home.hero.primaryCta.href }}">{{ home.hero.primaryCta.label }} <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="{{ home.hero.secondaryCta.href }}">{{ home.hero.secondaryCta.label }} <span aria-hidden="true">↗</span></a>
      </div>

      <div class="install-command reveal reveal-delay-4" data-copy-group>
        <span class="command-prompt" aria-hidden="true">$</span>
        <code>{{ home.hero.installCommand }}</code>
        <button type="button" class="copy-button" data-copy="{{ home.hero.installCommand }}" aria-label="Copy install command">
          <svg class="copy-icon" viewBox="0 0 20 20" aria-hidden="true"><rect x="6.5" y="6.5" width="9" height="9" rx="1.5"/><path d="M4 12.5H3.5A1.5 1.5 0 0 1 2 11V3.5A1.5 1.5 0 0 1 3.5 2H11a1.5 1.5 0 0 1 1.5 1.5V4"/></svg>
          <svg class="check-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9"/></svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>
      <p class="hero-caveat reveal reveal-delay-4"><strong>{{ home.hero.caveatLabel }}</strong> {{ home.hero.caveat }}</p>
    </div>

    <figure class="hero-visual reveal reveal-delay-2">
      <figcaption class="sr-only">Illustration of Dekopon’s committed authority model</figcaption>
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="citrus-slice" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>

      <div class="invocation-card">
        <div class="window-bar">
          <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span>{{ home.hero.visual.title }}</span>
          <span class="design-target">{{ home.hero.visual.badge }}</span>
        </div>

        <div class="proposal-block">
          <div class="block-heading">
            <span class="stage-index">01</span>
            <span>{{ home.hero.visual.stage }}</span>
            <span class="untrusted-tag">{{ home.hero.visual.trust }}</span>
          </div>
          <div class="code-line"><span>capability</span><strong>{{ home.hero.visual.capability }}</strong></div>
          <div class="code-line"><span>actor</span><strong>{{ home.hero.visual.actor }}</strong></div>
          <div class="code-line"><span>effect</span><strong class="effect-write">{{ home.hero.visual.effect }}</strong></div>
        </div>

        <div class="authority-gate">
          <span class="gate-line"></span>
          <span class="gate-pill"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 8V6a4.5 4.5 0 0 1 9 0v2M4 8h12v9H4z"/></svg> {{ home.hero.visual.boundary }}</span>
          <span class="gate-line"></span>
        </div>

        <div class="decision-grid">
          <div class="decision decision-denied">
            <span class="decision-mark">×</span>
            <div><small>{{ home.hero.visual.deniedLabel }}</small><strong>{{ home.hero.visual.denied }}</strong></div>
          </div>
          <div class="decision decision-authorized">
            <span class="decision-mark">✓</span>
            <div><small>{{ home.hero.visual.authorizedLabel }}</small><strong>{{ home.hero.visual.authorized }}</strong></div>
          </div>
        </div>

        <div class="evidence-row">
          <span class="pulse-ring" aria-hidden="true"></span>
          <div><small>{{ home.hero.visual.outcomeLabel }}</small><strong>{{ home.hero.visual.outcome }}</strong></div>
          <code>{{ home.hero.visual.trace }}</code>
        </div>
      </div>

      {% for chip in home.hero.visual.chips %}
        <div class="floating-chip chip-{{ loop.index }}"><span aria-hidden="true">{% if loop.index == 1 %}◆{% elif loop.index == 2 %}⌁{% else %}●{% endif %}</span> {{ chip }}</div>
      {% endfor %}
    </figure>
  </div>

  <div class="hero-slope" aria-hidden="true"></div>
</section>
