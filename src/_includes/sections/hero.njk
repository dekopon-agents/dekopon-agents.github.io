<section class="hero" id="top">
  <div class="hero-mesh" aria-hidden="true">
    <div class="mesh-blob mesh-blob-a"></div>
    <div class="mesh-blob mesh-blob-b"></div>
    <div class="mesh-blob mesh-blob-c"></div>
    <div class="mesh-blob mesh-blob-d"></div>
    <svg class="mesh-lines" viewBox="0 0 1600 900" preserveAspectRatio="none">
      <path d="M-120 756C205 473 427 678 708 450S1184 82 1708 217"/>
      <path d="M-81 853C222 586 472 777 765 539s500-352 902-272"/>
      <path d="M111-73c82 195 242 240 425 208s317-7 384 172"/>
    </svg>
  </div>

  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="eyebrow reveal">
        <span class="eyebrow-spark" aria-hidden="true"></span>
        {{ home.hero.eyebrow }}
      </div>
      <h1 class="reveal reveal-delay-1">{{ home.hero.title }}<br><span class="gradient-text">{{ home.hero.titleAccent }}</span></h1>
      <p class="hero-lede reveal reveal-delay-2">{{ home.hero.lede }}</p>
      <div class="hero-buttons reveal reveal-delay-3">
        <a class="button button-primary" href="{{ home.hero.primaryCta.href }}">{{ home.hero.primaryCta.label }} <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="{{ home.hero.secondaryCta.href }}">{{ home.hero.secondaryCta.label }} <span aria-hidden="true">↓</span></a>
      </div>
      <ul class="hero-proof-list reveal reveal-delay-4">
        {% for proof in home.hero.proofs %}<li><span aria-hidden="true">✓</span>{{ proof }}</li>{% endfor %}
      </ul>
      <p class="hero-release reveal reveal-delay-4">Latest release: <a href="{{ release.url }}"><strong>{{ release.tag }}</strong> · {{ release.dateShort }} <span aria-hidden="true">↗</span></a></p>
    </div>

    <figure class="hero-visual reveal reveal-delay-2">
      <figcaption class="sr-only">{{ home.hero.visual.caption }}</figcaption>
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="citrus-slice" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>

      <div class="invocation-card authority-map-card">
        <div class="window-bar">
          <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span>{{ home.hero.visual.title }}</span>
          <span class="design-target">{{ home.hero.visual.badge }}</span>
        </div>

        <div class="authority-map-flow">
          <article class="authority-map-node authority-map-request">
            <small>{{ home.hero.visual.requestLabel }}</small>
            <strong>{{ home.hero.visual.request }}</strong>
            <span>{{ home.hero.visual.requestDetail }}</span>
          </article>
          <div class="authority-map-arrow"><span>message ↓ reply ↑</span></div>
          <article class="authority-map-node authority-map-proposal">
            <small>{{ home.hero.visual.proposalLabel }}</small>
            <strong><code>{{ home.hero.visual.proposal }}</code></strong>
            <span>{{ home.hero.visual.proposalDetail }}</span>
          </article>
          <div class="authority-map-arrow authority-map-arrow-boundary"><span>proposal · never permission ↓</span></div>
          <article class="authority-map-node authority-map-broker">
            <small>{{ home.hero.visual.gateLabel }}</small>
            <strong>{{ home.hero.visual.gate }}</strong>
            <span>{{ home.hero.visual.gateDetail }}</span>
          </article>
        </div>

        <div class="decision-grid">
          <div class="decision decision-authorized">
            <span class="decision-mark">✓</span>
            <div><small>{{ home.hero.visual.allowedLabel }}</small><strong>{{ home.hero.visual.allowed }}</strong></div>
          </div>
          <div class="decision decision-denied">
            <span class="decision-mark">—</span>
            <div><small>{{ home.hero.visual.deniedLabel }}</small><strong>{{ home.hero.visual.denied }}</strong></div>
          </div>
        </div>

        <div class="evidence-row authority-map-outcome">
          <span class="pulse-ring" aria-hidden="true"></span>
          <div><small>{{ home.hero.visual.outcomeLabel }}</small><strong>{{ home.hero.visual.outcome }}</strong></div>
          <code>{{ home.hero.visual.audit }}</code>
        </div>
      </div>

      {% for chip in home.hero.visual.chips %}
        <div class="floating-chip chip-{{ loop.index }}"><span aria-hidden="true">{% if loop.index == 1 %}◆{% elif loop.index == 2 %}⌁{% else %}●{% endif %}</span> {{ chip }}</div>
      {% endfor %}
    </figure>
  </div>

  <div class="hero-slope" aria-hidden="true"></div>
</section>
