<section class="hero" id="top">
  <div class="hero-mesh" aria-hidden="true">
    <div class="mesh-blob mesh-blob-a"></div>
    <div class="mesh-blob mesh-blob-b"></div>
    <div class="mesh-blob mesh-blob-c"></div>
    <div class="mesh-blob mesh-blob-d"></div>
    <svg class="mesh-lines" viewBox="0 0 1600 900" preserveAspectRatio="none">
      <path d="M-120 756C205 473 427 678 708 450S1184 82 1708 217"/>
      <path d="M-81 853C222 586 472 777 765 539s500-352 902-272"/>
      <path d="M111-73c82 195 242 240 425 208s317-7 384 172"/>
    </svg>
  </div>

  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="eyebrow reveal">
        <span class="eyebrow-spark" aria-hidden="true"></span>
        {{ home.hero.eyebrow }}
      </div>
      <h1 class="reveal reveal-delay-1">{{ home.hero.title }}<br><span class="gradient-text">{{ home.hero.titleAccent }}</span></h1>
      <p class="hero-lede reveal reveal-delay-2">{{ home.hero.lede }}</p>
      <div class="hero-buttons reveal reveal-delay-3">
        <a class="button button-primary" href="{{ home.hero.primaryCta.href }}">{{ home.hero.primaryCta.label }} <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="{{ home.hero.secondaryCta.href }}">{{ home.hero.secondaryCta.label }} <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-release reveal reveal-delay-4">Latest release: <a href="{{ release.url }}"><strong>{{ release.tag }}</strong> · {{ release.dateShort }} <span aria-hidden="true">↗</span></a></p>
    </div>

    <figure class="hero-visual hero-diagram reveal reveal-delay-2" aria-labelledby="hero-diagram-caption">
      <div class="hero-diagram-top">
        <div class="hero-diagram-gateway" data-hero-boundary="gateway">
          <h2>Gateway</h2>
          <strong>Slack agent session</strong>
          <span>“{{ home.hero.visual.request }}”</span>
        </div>
        <div class="hero-diagram-exchange">
          <div class="hero-diagram-model-step" data-hero-step="1">
            <span><b class="hero-diagram-number">1</b> <span class="sr-only">Gateway to model: </span>Prompt + bash tool</span>
            <span class="hero-diagram-horizontal-arrow" aria-hidden="true">⟶</span>
            <small class="hero-diagram-mobile-route">Gateway → model</small>
          </div>
          <div class="hero-diagram-model-step" data-hero-step="2">
            <span><b class="hero-diagram-number">2</b> <span class="sr-only">Model to gateway: </span>Requested bash command</span>
            <span class="hero-diagram-horizontal-arrow" aria-hidden="true">⟵</span>
            <small class="hero-diagram-mobile-route">Model → gateway</small>
          </div>
        </div>
        <div class="hero-diagram-model" data-hero-boundary="model">
          <h2>AI provider</h2>
          <strong>Model</strong>
        </div>
      </div>

      <div class="hero-diagram-step hero-diagram-socket" data-hero-step="3">
        <span aria-hidden="true">↓</span><b class="hero-diagram-number">3</b>
        <span>Propose action <small>Unix socket</small></span>
      </div>

      <div class="hero-diagram-broker" data-hero-boundary="broker">
        <h2>Broker</h2>
        <div class="hero-diagram-policy" data-hero-boundary="policy">
          <span>Caller mapping</span>
          <strong>Pre-configured Cedar policy</strong>
        </div>
        <div class="hero-diagram-step" data-hero-step="4">
          <span aria-hidden="true">↓</span><b class="hero-diagram-number">4</b> Authorize capability
        </div>
        <div class="hero-diagram-wasm" data-hero-boundary="wasm">
          <h3>Wasm sandbox</h3>
          <strong>GitHub provider <span>· fresh invocation</span></strong>
          <p>Builds request, never sees GitHub PAT</p>
        </div>
        <div class="hero-diagram-step" data-hero-step="5">
          <span aria-hidden="true">↓</span><b class="hero-diagram-number">5</b> Request HTTP
        </div>
        <div class="hero-diagram-io">
          <div class="hero-diagram-http" data-hero-boundary="http">
            <h3>Broker-native HTTP</h3>
            <p>Destination / method / limits checks</p>
          </div>
          <span class="hero-diagram-credential-arrow" aria-hidden="true">←</span>
          <div class="hero-diagram-credential" data-hero-boundary="credential">
            <h3>Broker-held</h3>
            <strong>GitHub PAT</strong>
            <span class="sr-only">Feeds only broker-native HTTP, not the gateway or Wasm sandbox.</span>
          </div>
        </div>
      </div>

      <div class="hero-diagram-step hero-diagram-send" data-hero-step="6">
        <span aria-hidden="true">↓</span><b class="hero-diagram-number">6</b> Inject credential + send
      </div>
      <div class="hero-diagram-github" data-hero-boundary="github">
        <strong>api.github.com</strong><span>GET + POST</span>
      </div>
      <figcaption id="hero-diagram-caption">{{ home.hero.visual.caption }}</figcaption>
    </figure>
  </div>

  <div class="hero-slope" aria-hidden="true"></div>
</section>
