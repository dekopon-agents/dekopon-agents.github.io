<section class="resources-section section">
  <div class="shell resources-grid">
    <div class="resources-copy">
      <span class="section-kicker orange">{{ home.resources.kicker }}</span>
      <h2>{{ home.resources.title }}</h2>
      <p>{{ home.resources.intro }}</p>
      <div class="resource-points">
        {% for point in home.resources.points %}
          <div><span>{{ point.label }}</span><p><strong>{{ point.title }}</strong> {{ point.body }}</p></div>
        {% endfor %}
      </div>
      <a class="text-link" href="{{ home.resources.link.href }}">{{ home.resources.link.label }} <span aria-hidden="true">→</span></a>
    </div>

    <div class="code-composition reveal">
      <div class="code-card yaml-card">
        <div class="code-card-header">
          <div><span class="file-dot yaml"></span><strong id="agent-yaml-title">agent.yaml</strong></div>
          <span>dekopon.dev/v1alpha1</span>
        </div>
        <pre><code>{{ home.resources.yaml | yamlHighlight | safe }}</code></pre>
      </div>

      <div class="terminal-card">
        <div class="terminal-header"><span></span><span></span><span></span><strong>dekopon</strong></div>
        <pre><code>{{ home.resources.terminal | terminalHighlight | safe }}</code></pre>
      </div>
      <div class="code-orb" aria-hidden="true"></div>
    </div>
  </div>
</section>
