<section class="authority-section" id="cedar-policy" aria-labelledby="cedar-policy-title">
  <div class="authority-glow authority-glow-one" aria-hidden="true"></div>
  <div class="authority-glow authority-glow-two" aria-hidden="true"></div>
  <div class="shell authority-shell">
    <div class="section-heading dark-heading">
      <span class="section-kicker cyan">{{ home.authority.kicker }}</span>
      <h2 id="cedar-policy-title">{{ home.authority.title }}<br><span>{{ home.authority.titleAccent }}</span></h2>
      <p>{{ home.authority.intro }}</p>
    </div>

    <div class="cedar-home-example">
      <article class="cedar-home-policy reveal">
        <div class="cedar-home-policy-header">
          <span>{{ home.authority.policyFile }}</span>
          <small>complete policy set for this synthetic agent</small>
        </div>
        <pre><code>{{ home.authority.policy }}</code></pre>
      </article>

      <article class="cedar-home-decision reveal reveal-delay-1">
        <span class="cedar-home-label">Trusted authorization request</span>
        <dl>
          {% for field in home.authority.request %}
            <div><dt>{{ field.label }}</dt><dd><code>{{ field.value }}</code></dd></div>
          {% endfor %}
        </dl>

        <div class="cedar-home-allow">
          <span aria-hidden="true">✓</span>
          <div><small>{{ home.authority.decisionLabel }}</small><strong><code>{{ home.authority.decision }}</code></strong></div>
        </div>
        <p>{{ home.authority.decisionBody }}</p>

        <h3>{{ home.authority.constraintsTitle }}</h3>
        <ul>
          {% for constraint in home.authority.constraints %}<li>{{ constraint }}</li>{% endfor %}
        </ul>
        <p class="cedar-home-denial"><strong>Deny example:</strong> {{ home.authority.denial }}</p>
      </article>
    </div>

    <div class="invariant-grid">
      {% for invariant in home.authority.invariants %}
        <article>
          <span class="invariant-mark {{ invariant.class }}">{{ invariant.number }}</span>
          <h3>{{ invariant.title }}</h3>
          <p>{{ invariant.body }}</p>
        </article>
      {% endfor %}
    </div>

    <a class="button cedar-home-link" href="{{ home.authority.link.href }}">{{ home.authority.link.label }} <span aria-hidden="true">→</span></a>
  </div>
</section>
