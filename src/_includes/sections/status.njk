<section class="status-section section" id="provider-sdk" aria-labelledby="provider-sdk-title">
  <div class="shell">
    <div class="section-heading split-heading compact-heading">
      <div>
        {% if home.status.kicker %}<span class="section-kicker orange">{{ home.status.kicker }}</span>{% endif %}
        <h2 id="provider-sdk-title">{{ home.status.title }}</h2>
      </div>
      <p>{{ home.status.intro }}</p>
    </div>

    <div class="status-grid">
      <article class="status-panel current-panel reveal">
        <div class="status-panel-top">
          <span class="status-label current"><span></span>{{ home.status.provider.label }}</span>
          <span class="status-number">{{ home.status.provider.number }}</span>
        </div>
        <h3>{{ home.status.provider.title }}</h3>
        <p>{{ home.status.provider.body }}</p>
        <ul class="check-list">
          {% for point in home.status.provider.points %}<li>{{ point }}</li>{% endfor %}
        </ul>
        <div class="path-strip">
          <span class="sr-only">How provider code reaches the agent sandbox:</span>
          {% for step in home.status.provider.path %}<span>{{ step }}</span>{% if not loop.last %}<i aria-hidden="true">→</i>{% endif %}{% endfor %}
        </div>
        <a class="text-link status-link" href="{{ home.status.provider.link.href }}">{{ home.status.provider.link.label }} <span aria-hidden="true">→</span></a>
      </article>

      <article class="status-panel direction-panel secret-panel reveal reveal-delay-1">
        <div class="status-panel-top">
          <span class="status-label direction"><span></span>{{ home.status.secrets.label }}</span>
          <span class="status-number">{{ home.status.secrets.number }}</span>
        </div>
        <h3>{{ home.status.secrets.title }}</h3>
        <p>{{ home.status.secrets.body }}</p>
        <ul class="arrow-list secret-boundary-list">
          {% for item in home.status.secrets.items %}<li><strong>{{ item.name }}</strong><span>{{ item.description }}</span></li>{% endfor %}
        </ul>
        <p class="not-yet"><span aria-hidden="true">!</span> {{ home.status.secrets.note }}</p>
        <a class="text-link status-link" href="{{ home.status.secrets.link.href }}">{{ home.status.secrets.link.label }} <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>
